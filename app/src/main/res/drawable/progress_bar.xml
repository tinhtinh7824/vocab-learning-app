<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền của thanh tiến trình -->
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#33808B"/> <!-- Màu xám nhạt cho nền -->
            <corners android:radius="8dp"/> <!-- Bo tròn các góc với bán kính 8dp -->
        </shape>
    </item>
    <!-- Tiến trình -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="#33808B"/> <!-- Màu xanh lá cho tiến trình -->
                <corners android:radius="8dp"/> <!-- Bo tròn các góc với bán kính 8dp -->
            </shape>
        </clip>
    </item>
</layer-list>
